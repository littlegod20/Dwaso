# Copy to .env for local development. Every value below has a working default
# except the connection strings, so `pnpm dev:api` runs against a local Postgres
# and Redis with nothing else configured.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# --- Data ---------------------------------------------------------------
# Ports match docker-compose.yml (host 5434/6380 → container 5432/6379).
DATABASE_URL=postgres://postgres:postgres@localhost:5434/dwaso
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6380

# --- Auth ---------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=development-only-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_SECONDS=900
# 60 days: an offline-first device may be off the network for weeks and must
# still sync on reconnect without forcing the trader to log in again.
REFRESH_TOKEN_TTL_SECONDS=5184000

# Comma-separated. Left blank in development, which permits any origin.
CORS_ORIGINS=

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# --- Messaging ----------------------------------------------------------
# "console" prints the OTP to the log instead of sending it, so local
# development costs nothing. Rejected at boot when NODE_ENV=production.
SMS_PROVIDER=console
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=Dwaso
TERMII_API_KEY=
TERMII_SENDER_ID=Dwaso

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Scanning -----------------------------------------------------------
# Only the third tier of the scan cascade needs this; barcode and on-device
# matching work without any key configured.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-6
SCAN_DAILY_QUOTA_PER_SHOP=200

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Suppliers ----------------------------------------------------------
GOOGLE_PLACES_API_KEY=
PLACES_CACHE_TTL_SECONDS=86400

# --- Push ---------------------------------------------------------------
EXPO_ACCESS_TOKEN=

# --- Observability ------------------------------------------------------
# Off by default so local development does not need a collector running. When
# enabled, the endpoint below is the standard OTLP variable the SDK reads.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dwaso-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Retention ----------------------------------------------------------
# A device whose sync cursor is older than this must rebuild from scratch.
TOMBSTONE_RETENTION_DAYS=90
SCAN_IMAGE_RETENTION_DAYS=180
MESSAGE_LOG_RETENTION_DAYS=365
